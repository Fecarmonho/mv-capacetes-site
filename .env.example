# Chaves públicas do app cliente (Configurações do projeto > Geral > Seus apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Chave secreta do Admin SDK (Configurações do projeto > Contas de serviço > Gerar nova chave privada)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# O WhatsApp, Instagram, e-mail etc. da loja NÃO ficam aqui — são
# configurados pelo próprio admin em /admin/configuracoes (coleção
# "configuracoes" no Firestore), pra poder trocar sem novo deploy.
